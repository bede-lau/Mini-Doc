# --------------------------------------------------------------------------
# Mini-Doc — environment configuration.
# Copy to .env and edit. All values have sensible defaults, so the app runs
# WITHOUT any API key (it falls back to a deterministic offline answer mode).
# --------------------------------------------------------------------------

# --- Paths ---
# Repo root is auto-detected; override only if you run from elsewhere.
# EOS_REPO_ROOT=

# Timezone used for report timestamps and logs (IANA name).
EOS_TIMEZONE=Asia/Singapore

# --- Qdrant vector DB ---
QDRANT_URL=http://localhost:6333
# Optional: only needed for Qdrant Cloud. Leave blank for local Docker.
QDRANT_API_KEY=
QDRANT_COLLECTION=evidenceos_chunks

# --- Embeddings (local by default) ---
# SentenceTransformers model. bge-small = 384-dim, fast, local.
EOS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EOS_EMBEDDING_DIM=384
# Where to cache downloaded HF models (defaults to ./models).
EOS_MODEL_CACHE_DIR=

# --- Chunking ---
EOS_CHUNK_SIZE=700
EOS_CHUNK_OVERLAP=120

# --- Retrieval ---
EOS_TOP_K=8
# Cosine similarity below this => "insufficient_evidence".
EOS_ABSTENTION_THRESHOLD=0.35

# --- LLM provider (OPTIONAL) ---
# Provider: "offline" (default, deterministic, no key), "openai" (also works for
# local OpenAI-compatible servers / vLLM / Ollama), or "anthropic".
EOS_LLM_PROVIDER=offline
EOS_LLM_MODEL=gpt-4o-mini
EOS_LLM_API_KEY=
# For OpenAI-compatible local servers, e.g. http://localhost:11434/v1 (Ollama).
EOS_LLM_BASE_URL=
EOS_LLM_TEMPERATURE=0.0

# --- Force offline even if a key is set (useful for reproducible benchmarks) ---
EOS_FORCE_OFFLINE=false
